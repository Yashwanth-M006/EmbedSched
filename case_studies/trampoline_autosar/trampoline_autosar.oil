OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {
    TASK {
        UINT32 STACKSIZE = 512 ;
    } ;
    ISR {
        UINT32 STACKSIZE = 256 ;
    } ;
};

CPU trampoline_stm32f407 {
  OS config {
    STATUS = EXTENDED;
    
    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../benchmark_projects/trampoline";
      APP_SRC = "trampoline_autosar.c";
      APP_NAME = "trampoline_autosar_exe";
      CFLAGS  = "-O2 -fstack-usage"; 
      LDFLAGS = "-Map=trampoline_autosar.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };
  
  APPMODE stdAppmode {};
  
  RESOURCE led_resource {
    RESOURCEPROPERTY = STANDARD;
  };

  TASK read_button {
    PRIORITY = 2;
    AUTOSTART = TRUE { APPMODE = stdAppmode; };
    ACTIVATION = 1;
    SCHEDULE = FULL;
    RESOURCE = led_resource;
  };

  TASK blink {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
    RESOURCE = led_resource;
  };
  
  ALARM blink_alarm {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK {
      TASK = blink;
    };
    AUTOSTART = TRUE {
      ALARMTIME = 10;
      CYCLETIME = 10;
      APPMODE = stdAppmode;
    };
  };

  ISR isr_button {
    CATEGORY = 2;
    PRIORITY = 1;
    SOURCE = EXTI0_IRQ { PIN = PA0 { TRIGGER = RISING; PULL = NONE; }; };
  };
};
